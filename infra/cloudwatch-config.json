{
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          {
            "file_path": "C:\\figma-mcp-proxy\\logs\\stdout.log",
            "log_group_name": "/aws/ec2/figma-proxy",
            "log_stream_name": "{instance_id}/stdout",
            "timezone": "UTC"
          },
          {
            "file_path": "C:\\figma-mcp-proxy\\logs\\stderr.log",
            "log_group_name": "/aws/ec2/figma-proxy",
            "log_stream_name": "{instance_id}/stderr",
            "timezone": "UTC"
          }
        ]
      }
    }
  },
  "metrics": {
    "namespace": "CWAgent",
    "aggregation_dimensions": [["InstanceId"]],
    "metrics_collected": {
      "Memory": {
        "measurement": [
          {
            "name": "% Committed Bytes In Use",
            "rename": "MemoryUtilization",
            "unit": "Percent"
          },
          {
            "name": "Available MBytes",
            "rename": "MemoryAvailableMBytes",
            "unit": "Megabytes"
          }
        ],
        "metrics_collection_interval": 60
      },
      "LogicalDisk": {
        "measurement": [
          {
            "name": "% Free Space",
            "rename": "DiskFreeSpace",
            "unit": "Percent"
          },
          {
            "name": "Free Megabytes",
            "rename": "DiskFreeMBytes",
            "unit": "Megabytes"
          }
        ],
        "metrics_collection_interval": 60,
        "resources": ["*"]
      }
    }
  }
}
